{
  "name": "@penguinharness/rsi-workbench",
  "version": "0.1.0",
  "type": "module",
  "description": "The Self-Evolution Workbench for PenguinHarness: create, import, evaluate and optimize Agents against Benchmarks from the App Center, with the benchmark-design and agent-evaluation Skills.",
  "keywords": [
    "penguin-plugin",
    "penguinharness",
    "benchmark",
    "evaluation",
    "rsi",
    "skills"
  ],
  "license": "Apache-2.0",
  "author": {
    "name": "Prism-Shadow",
    "url": "https://github.com/Prism-Shadow"
  },
  "homepage": "https://github.com/Prism-Shadow/penguin-harness-rsi-platform#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Prism-Shadow/penguin-harness-rsi-platform.git"
  },
  "bugs": {
    "url": "https://github.com/Prism-Shadow/penguin-harness-rsi-platform/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.18.0",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./format": {
      "types": "./dist/format/index.d.ts",
      "import": "./dist/format/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "ui",
    "seeds",
    "skills",
    "ifaces.json",
    "icon.svg",
    "LICENSE",
    "README.md",
    "README.zh.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@prismshadow/penguin-server": ">=0.2.19"
  },
  "peerDependenciesMeta": {
    "@prismshadow/penguin-server": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsup && vite build && node scripts/gen-ifaces.mjs --project tsconfig.json --out ifaces.json && pnpm --filter \"./plugins/*\" --workspace-concurrency=2 run build",
    "build-seeds": "node scripts/build-seeds.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.ui.json && pnpm --filter \"./plugins/*\" --workspace-concurrency=2 exec tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pack:check": "node scripts/pack-check.mjs"
  },
  "devDependencies": {
    "@prismshadow/penguin-core": "0.2.18",
    "@prismshadow/penguin-ui": "0.2.18",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "fflate": "^0.8.2",
    "happy-dom": "^20.0.0",
    "hono": "^4.13.11",
    "prettier": "^3.9.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "smol-toml": "^1.9.1",
    "tailwindcss": "^4.1.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "yaml": "^2.5.0"
  }
}

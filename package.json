{
  "name": "@penguinharness/rsi-workbench",
  "version": "0.2.0",
  "type": "module",
  "description": "The Self-Evolution Workbench for PenguinHarness: a workbench of the default Agent to create, import, evaluate and optimize Agents against its Benchmarks, with the benchmark-design and agent-evaluation Skills and the Benchmark format as ./format.",
  "keywords": [
    "penguin-plugin",
    "penguinharness",
    "benchmark",
    "evaluation",
    "rsi",
    "skills"
  ],
  "license": "Apache-2.0",
  "author": {
    "name": "Prism-Shadow",
    "url": "https://github.com/Prism-Shadow"
  },
  "homepage": "https://github.com/Prism-Shadow/penguin-harness-rsi-platform#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Prism-Shadow/penguin-harness-rsi-platform.git"
  },
  "bugs": {
    "url": "https://github.com/Prism-Shadow/penguin-harness-rsi-platform/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.18.0",
  "exports": {
    "./format": {
      "types": "./dist/format/index.d.ts",
      "import": "./dist/format/index.js"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "import": "./dist/api/index.js"
    },
    "./prompts": {
      "types": "./dist/prompts/index.d.ts",
      "import": "./dist/prompts/index.js"
    },
    "./workbenches/*": "./workbenches/*",
    "./icon.svg": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/format",
    "dist/api",
    "dist/prompts",
    "workbenches",
    "skills",
    "ifaces.json",
    "icon.svg",
    "LICENSE",
    "README.md",
    "README.zh.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && vite build && node scripts/copy-format.mjs && penguin-gen-ifaces --project tsconfig.json --sources src --out ifaces.json && pnpm --filter \"./plugins/*\" --workspace-concurrency=2 run build",
    "build-seeds": "node scripts/build-seeds.mjs",
    "typecheck": "node scripts/copy-format.mjs --check && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.ui.json && node scripts/check-workbench.mjs && pnpm --filter \"./plugins/*\" --workspace-concurrency=2 exec tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pack:check": "node scripts/pack-check.mjs"
  },
  "devDependencies": {
    "@prismshadow/penguin-core": "0.2.19",
    "@prismshadow/penguin-ui": "0.2.19",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "fflate": "^0.8.2",
    "happy-dom": "^20.0.0",
    "prettier": "^3.9.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "smol-toml": "1.9.1",
    "tailwindcss": "^4.1.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "yaml": "2.9.1"
  }
}
